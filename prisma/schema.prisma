generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  EXITED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AppraisalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

enum TrainingStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobOpeningStatus {
  OPEN
  ON_HOLD
  FILLED
  CLOSED
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DisciplinaryStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

model Branch {
  id        String           @id @default(cuid())
  name      String           @unique
  location  String?
  employees Employee[]
  scopes    UserAccessScope[]
  jobOpenings JobOpening[]
  createdAt DateTime         @default(now())
}

model Employee {
  id               String         @id @default(cuid())
  employeeNo       String         @unique
  firstName        String
  lastName         String
  email            String         @unique
  phone            String?
  position         String
  department       String
  status           EmployeeStatus @default(ACTIVE)
  hireDate         DateTime       @default(now())
  branchId         String
  branch           Branch         @relation(fields: [branchId], references: [id])
  employmentType   String         @default("FULL_TIME")
  emergencyContact String?
  notes            String?
  leaveRequests    LeaveRequest[]
  appraisals       Appraisal[]
  onboardingCases  OnboardingCase[]
  disciplinaryCases DisciplinaryCase[]
  recognitions     Recognition[]
  user             User?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([branchId])
  @@index([status])
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String
  passwordHash String
  active       Boolean          @default(true)
  employeeId   String?          @unique
  employee     Employee?        @relation(fields: [employeeId], references: [id])
  roles        UserRole[]
  scopes       UserAccessScope[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  system      Boolean          @default(false)
  protected   Boolean          @default(false)
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
}

model UserAccessScope {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch? @relation(fields: [branchId], references: [id])
  department String?

  @@unique([userId, branchId, department])
  @@index([userId])
}

model LeaveRequest {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  type       String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  decisionNote String?
  decidedBy  String?
  decidedAt  DateTime?
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  @@index([employeeId])
  @@index([status])
}

model Appraisal {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  title      String
  score      Float?
  period     String
  status     AppraisalStatus @default(DRAFT)
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model PayrollRun {
  id          String   @id @default(cuid())
  period      String   @unique
  status      PayrollStatus @default(DRAFT)
  grossAmount Decimal  @default(0)
  netAmount   Decimal  @default(0)
  createdAt   DateTime @default(now())
}

model Training {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      TrainingStatus @default(PLANNED)
  createdAt   DateTime @default(now())
}

model JobOpening {
  id        String   @id @default(cuid())
  title     String
  branchId  String
  branch    Branch           @relation(fields: [branchId], references: [id])
  status    JobOpeningStatus @default(OPEN)
  createdAt DateTime         @default(now())

  @@index([branchId])
  @@index([status])
}

model OnboardingCase {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  kind       String
  status     OnboardingStatus @default(PENDING)
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

model DisciplinaryCase {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  summary    String
  status     DisciplinaryStatus @default(OPEN)
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

model Recognition {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  title      String
  awardedAt  DateTime @default(now())

  @@index([employeeId])
}
