generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  EXITED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AppraisalStatus {
  DRAFT
  SUBMITTED
  MANAGER_REVIEWED
  PENDING_HR_APPROVAL
  APPROVED
  REJECTED
  FINALIZED
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

enum TrainingStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobOpeningStatus {
  OPEN
  ON_HOLD
  FILLED
  CLOSED
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DisciplinaryStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

model Branch {
  id        String           @id @default(cuid())
  name      String           @unique
  location  String?
  employees Employee[]
  scopes    UserAccessScope[]
  jobOpenings JobOpening[]
  createdAt DateTime         @default(now())
}

model Employee {
  id               String         @id @default(cuid())
  employeeNo       String         @unique
  firstName        String
  lastName         String
  email            String         @unique
  phone            String?
  position         String
  department       String
  status           EmployeeStatus @default(ACTIVE)
  hireDate         DateTime       @default(now())
  branchId         String
  branch           Branch         @relation(fields: [branchId], references: [id])
  employmentType   String         @default("FULL_TIME")
  emergencyContact String?
  notes            String?
  leaveRequests    LeaveRequest[]
  leaveEntitlements LeaveEntitlement[]
  appraisals       Appraisal[]
  appraisalReviews AppraisalReview[]
  onboardingCases  OnboardingCase[]
  disciplinaryCases DisciplinaryCase[]
  recognitions     Recognition[]
  user             User?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([branchId])
  @@index([status])
performanceImprovementPlans PerformanceImprovementPlan[]
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String
  passwordHash String
  active       Boolean          @default(true)
  employeeId   String?          @unique
  employee     Employee?        @relation(fields: [employeeId], references: [id])
  roles        UserRole[]
  scopes       UserAccessScope[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  system      Boolean          @default(false)
  protected   Boolean          @default(false)
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
}

model UserAccessScope {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch? @relation(fields: [branchId], references: [id])
  department String?

  @@unique([userId, branchId, department])
  @@index([userId])
}

model LeaveRequest {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  type       String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  days       Int           @default(1)
  reviewStage Int           @default(1)
  firstReviewerId String?
  firstReviewedAt DateTime?
  decisionNote String?
  decidedBy  String?
  decidedAt  DateTime?
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  @@index([employeeId])
  @@index([status])
}

model LeavePolicy {
  id String @id @default(cuid())
  type String @unique
  annualDays Int @default(0)
  approvalSteps Int @default(2)
  updatedAt DateTime @updatedAt
}

model LeaveEntitlement {
  id String @id @default(cuid())
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id])
  type String
  year Int
  days Int
  @@unique([employeeId,type,year])
}

model Appraisal {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  title      String
  score      Float?
  period     String
  status     AppraisalStatus @default(DRAFT)
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model PayrollRun {
  id          String   @id @default(cuid())
  period      String   @unique
  status      PayrollStatus @default(DRAFT)
  grossAmount Decimal  @default(0)
  netAmount   Decimal  @default(0)
  createdAt   DateTime @default(now())
}

model Training {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      TrainingStatus @default(PLANNED)
  createdAt   DateTime @default(now())
}

model JobOpening {
  id        String   @id @default(cuid())
  title     String
  branchId  String
  branch    Branch           @relation(fields: [branchId], references: [id])
  status    JobOpeningStatus @default(OPEN)
  createdAt DateTime         @default(now())

  @@index([branchId])
  @@index([status])
}

model OnboardingCase {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  kind       String
  status     OnboardingStatus @default(PENDING)
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

model DisciplinaryCase {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  summary    String
  status     DisciplinaryStatus @default(OPEN)
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

model Recognition {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  title      String
  awardedAt  DateTime @default(now())

  @@index([employeeId])
}


model AppraisalTemplate {
  id String @id @default(cuid())
  name String @unique
  category String
  level String
  description String?
  criteria Json
  active Boolean @default(true)
  deletedAt DateTime?
  deletedReason String?
  createdAt DateTime @default(now())
  reviews AppraisalReview[]
}

model AppraisalReview {
  id String @id @default(cuid())
  employeeId String
  employee Employee @relation(fields:[employeeId],references:[id])
  templateId String
  template AppraisalTemplate @relation(fields:[templateId],references:[id])
  period String
  status AppraisalStatus @default(DRAFT)
  selfScores Json?
  managerScores Json?
  selfComment String?
  managerComment String?
  score Float?
  reviewerId String?
  approvedBy String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([employeeId,period])
  @@index([status])
}

model AppraisalCycle {
  id String @id @default(cuid())
  name String
  period String
  startDate DateTime
  selfDeadline DateTime
  managerDeadline DateTime
  endDate DateTime
  status String @default("OPEN")
  createdBy String
  createdAt DateTime @default(now())
  assignments AppraisalCycleAssignment[]
  @@index([status, endDate])
}

model AppraisalCycleAssignment {
  id String @id @default(cuid())
  cycleId String
  cycle AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId String
  templateId String
  reviewId String?
  status String @default("PENDING")
  selfCompletedAt DateTime?
  managerCompletedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([cycleId, status])
}

model PerformanceImprovementPlan {
  id String @id @default(cuid())
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id])
  title String
  reason String
  goals Json
  status String @default("DRAFT") // DRAFT, ACTIVE, COMPLETED, UNSUCCESSFUL, CANCELLED
  startDate DateTime
  dueDate DateTime
  createdById String
  managerId String?
  closedById String?
  closedAt DateTime?
  outcomeNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  checkIns PerformanceImprovementCheckIn[]
  @@index([employeeId, status])
  @@index([dueDate, status])
}

model PerformanceImprovementCheckIn {
  id String @id @default(cuid())
  planId String
  plan PerformanceImprovementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  authorId String
  progressNote String
  progressPercent Int
  nextSteps String?
  createdAt DateTime @default(now())
  @@index([planId, createdAt])
}

// improvementPlans PerformanceImprovementPlan[]
