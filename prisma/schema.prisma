generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  EXITED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AppraisalStatus {
  DRAFT
  SUBMITTED
  MANAGER_REVIEWED
  PENDING_HR_APPROVAL
  APPROVED
  REJECTED
  FINALIZED
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

enum TrainingStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobOpeningStatus {
  OPEN
  ON_HOLD
  FILLED
  CLOSED
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DisciplinaryStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

model Branch {
  id          String            @id @default(cuid())
  name        String            @unique
  location    String?
  employees   Employee[]
  scopes      UserAccessScope[]
  jobOpenings JobOpening[]
  recruitmentRequisitions RecruitmentRequisition[]
  createdAt   DateTime          @default(now())
}

model Employee {
  id                          String                       @id @default(cuid())
  employeeNo                  String                       @unique
  firstName                   String
  lastName                    String
  email                       String                       @unique
  phone                       String?
  position                    String
  department                  String
  status                      EmployeeStatus               @default(ACTIVE)
  hireDate                    DateTime                     @default(now())
  branchId                    String
  branch                      Branch                       @relation(fields: [branchId], references: [id])
  employmentType              String                       @default("FULL_TIME")
  emergencyContact            String?
  notes                       String?
  leaveRequests               LeaveRequest[]
  leaveEntitlements           LeaveEntitlement[]
  appraisals                  Appraisal[]
  appraisalReviews            AppraisalReview[]
  onboardingCases             OnboardingCase[]
  onboardingTasks             OnboardingTask[]
  exitCases                   EmployeeExitCase[]
  disciplinaryCases           DisciplinaryCase[]
  disciplinaryHearings        DisciplinaryHearing[]
  disciplinaryAppeals         DisciplinaryAppeal[]
  recognitions                Recognition[]
  user                        User?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  performanceImprovementPlans PerformanceImprovementPlan[]
  compensationPackages        EmployeeCompensation[]
  payrollAttendance           PayrollAttendance[]
  ghanaPayrollAdjustments     GhanaPayrollAdjustment[]
  trainingEnrollments         TrainingEnrollment[]
  trainingAttendance          TrainingAttendance[]
  trainingEvaluationResponses TrainingEvaluationResponse[]

  @@index([branchId])
  @@index([status])
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String
  active       Boolean           @default(true)
  employeeId   String?           @unique
  employee     Employee?         @relation(fields: [employeeId], references: [id])
  roles        UserRole[]
  scopes       UserAccessScope[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  system      Boolean          @default(false)
  protected   Boolean          @default(false)
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
}

model UserAccessScope {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch? @relation(fields: [branchId], references: [id])
  department String?

  @@unique([userId, branchId, department])
  @@index([userId])
}

model LeaveRequest {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  type            String
  startDate       DateTime
  endDate         DateTime
  reason          String?
  days            Int           @default(1)
  reviewStage     Int           @default(1)
  firstReviewerId String?
  firstReviewedAt DateTime?
  decisionNote    String?
  decidedBy       String?
  decidedAt       DateTime?
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())

  @@index([employeeId])
  @@index([status])
}

model LeavePolicy {
  id            String   @id @default(cuid())
  type          String   @unique
  annualDays    Int      @default(0)
  approvalSteps Int      @default(2)
  updatedAt     DateTime @updatedAt
}

model LeaveEntitlement {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String
  year       Int
  days       Int

  @@unique([employeeId, type, year])
}

model Appraisal {
  id         String          @id @default(cuid())
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id])
  title      String
  score      Float?
  period     String
  status     AppraisalStatus @default(DRAFT)
  createdAt  DateTime        @default(now())

  @@index([employeeId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model PayrollRun {
  id          String        @id @default(cuid())
  period      String        @unique
  status      PayrollStatus @default(DRAFT)
  grossAmount Decimal       @default(0)
  netAmount   Decimal       @default(0)
  createdAt   DateTime      @default(now())
}

model Training {
  id                  String                       @id @default(cuid())
  title               String
  description         String?
  status              TrainingStatus               @default(PLANNED)
  code                String?                      @unique
  category            String?
  trainingType        String?                      @default("OPTIONAL")
  deliveryMethod      String?
  trainer             String?
  startDate           DateTime?
  endDate             DateTime?
  durationHours       Float?
  location            String?
  targetAudience      String?
  maxParticipants     Int?
  estimatedCost       Decimal?                     @db.Decimal(12, 2)
  assessmentRequired  Boolean                      @default(false)
  passingScore        Float?
  createdById         String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  enrollments         TrainingEnrollment[]
  attendanceSessions  TrainingAttendanceSession[]
  evaluationQuestions TrainingEvaluationQuestion[]
  evaluationResponses TrainingEvaluationResponse[]

  @@index([status, startDate])
  @@index([category])
}

enum TrainingEnrollmentStatus {
  ENROLLED
  WITHDRAWN
  COMPLETED
}

model TrainingEnrollment {
  id           String                       @id @default(cuid())
  trainingId   String
  employeeId   String
  status       TrainingEnrollmentStatus     @default(ENROLLED)
  enrolledById String?
  enrolledAt   DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  training     Training                     @relation(fields: [trainingId], references: [id], onDelete: Restrict)
  employee     Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendance   TrainingAttendance[]
  evaluations  TrainingEvaluationResponse[]

  @@unique([trainingId, employeeId])
  @@index([employeeId, status])
  @@index([trainingId, status])
}

enum TrainingAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model TrainingAttendanceSession {
  id          String               @id @default(cuid())
  trainingId  String
  sessionDate DateTime             @db.Date
  title       String?
  createdById String?
  createdAt   DateTime             @default(now())
  training    Training             @relation(fields: [trainingId], references: [id], onDelete: Restrict)
  records     TrainingAttendance[]

  @@unique([trainingId, sessionDate])
  @@index([trainingId])
}

model TrainingAttendance {
  id           String                    @id @default(cuid())
  sessionId    String
  enrollmentId String
  employeeId   String
  status       TrainingAttendanceStatus
  markedById   String
  markedAt     DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  session      TrainingAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  enrollment   TrainingEnrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  employee     Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([sessionId, enrollmentId])
  @@index([employeeId, status])
  @@index([sessionId, status])
}

model JobOpening {
  id        String           @id @default(cuid())
  title     String
  branchId  String
  branch    Branch           @relation(fields: [branchId], references: [id])
  status    JobOpeningStatus @default(OPEN)
  createdAt DateTime         @default(now())

  @@index([branchId])
  @@index([status])
}

model OnboardingCase {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  kind       String
  status     OnboardingStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  tasks      OnboardingTask[]

  @@index([employeeId])
}

model OnboardingTask {
  id             String         @id @default(cuid())
  caseId         String
  onboardingCase OnboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  title          String
  category       String         @default("HR")
  completed      Boolean        @default(false)
  completedAt    DateTime?
  completedById  String?
  dueDate        DateTime?
  createdAt      DateTime       @default(now())

  @@index([caseId])
  @@index([employeeId])
}

model DisciplinaryCase {
  id         String             @id @default(cuid())
  employeeId String
  employee   Employee           @relation(fields: [employeeId], references: [id])
  summary    String
  status     DisciplinaryStatus @default(OPEN)
  createdAt  DateTime           @default(now())

  category          String    @default("OTHER")
  severity          String    @default("MINOR")
  incidentDate      DateTime  @default(now())
  location          String?
  reportedBy        String?
  description       String?
  assignedTo        String?
  employeeResponse  String?
  investigationNote String?
  decision          String?
  decidedAt         DateTime?
  policyOffenceCode String?
  policyVersion     String?
  sanctionApplied   String?
  sanctionRationale String?
  hearings          DisciplinaryHearing[]
  appeals           DisciplinaryAppeal[]
}

model Recognition {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  title      String
  awardedAt  DateTime @default(now())

  @@index([employeeId])
}

model AppraisalTemplate {
  id            String            @id @default(cuid())
  name          String            @unique
  category      String
  level         String
  description   String?
  criteria      Json
  active        Boolean           @default(true)
  deletedAt     DateTime?
  deletedReason String?
  createdAt     DateTime          @default(now())
  reviews       AppraisalReview[]
}

model AppraisalReview {
  id             String            @id @default(cuid())
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id])
  templateId     String
  template       AppraisalTemplate @relation(fields: [templateId], references: [id])
  period         String
  status         AppraisalStatus   @default(DRAFT)
  selfScores     Json?
  managerScores  Json?
  selfComment    String?
  managerComment String?
  score          Float?
  reviewerId     String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([employeeId, period])
  @@index([status])
}

model AppraisalCycle {
  id              String                     @id @default(cuid())
  name            String
  period          String
  startDate       DateTime
  selfDeadline    DateTime
  managerDeadline DateTime
  endDate         DateTime
  status          String                     @default("OPEN")
  createdBy       String
  createdAt       DateTime                   @default(now())
  assignments     AppraisalCycleAssignment[]

  @@index([status, endDate])
}

model AppraisalCycleAssignment {
  id                 String         @id @default(cuid())
  cycleId            String
  cycle              AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId         String
  templateId         String
  reviewId           String?
  status             String         @default("PENDING")
  selfCompletedAt    DateTime?
  managerCompletedAt DateTime?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([cycleId, status])
}

model PerformanceImprovementPlan {
  id          String                          @id @default(cuid())
  employeeId  String
  employee    Employee                        @relation(fields: [employeeId], references: [id])
  title       String
  reason      String
  goals       Json
  status      String                          @default("DRAFT") // DRAFT, ACTIVE, COMPLETED, UNSUCCESSFUL, CANCELLED
  startDate   DateTime
  dueDate     DateTime
  createdById String
  managerId   String?
  closedById  String?
  closedAt    DateTime?
  outcomeNote String?
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt
  checkIns    PerformanceImprovementCheckIn[]

  @@index([employeeId, status])
  @@index([dueDate, status])
}

model PerformanceImprovementCheckIn {
  id              String                     @id @default(cuid())
  planId          String
  plan            PerformanceImprovementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  authorId        String
  progressNote    String
  progressPercent Int
  nextSteps       String?
  createdAt       DateTime                   @default(now())

  @@index([planId, createdAt])
}

// improvementPlans PerformanceImprovementPlan[]

// Compensation history: each approved package is immutable and effective-dated.
enum CompensationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model EmployeeCompensation {
  id            String             @id @default(cuid())
  employeeId    String
  employee      Employee           @relation(fields: [employeeId], references: [id])
  effectiveDate DateTime
  basicSalary   Decimal            @db.Decimal(14, 2)
  allowances    Json
  deductions    Json
  benefits      Json
  currency      String             @default("GHS")
  status        CompensationStatus @default(DRAFT)
  reason        String?
  reviewNote    String?
  createdById   String
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([employeeId, effectiveDate])
  @@index([status])
}

enum PayrollAttendanceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model PayrollAttendance {
  id              String                  @id @default(cuid())
  employeeId      String
  employee        Employee                @relation(fields: [employeeId], references: [id])
  workDate        DateTime                @db.Date
  clockIn         String?
  clockOut        String?
  breakMinutes    Int                     @default(0)
  regularMinutes  Int                     @default(0)
  overtimeMinutes Int                     @default(0)
  notes           String?
  status          PayrollAttendanceStatus @default(DRAFT)
  submittedById   String
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([employeeId, workDate])
  @@index([workDate, status])
}

// Payroll calculation snapshots: intentionally separate from legacy PayrollRun.
// These are DRAFT estimates, not approved payments or statutory tax calculations.
model PayrollCalculationBatch {
  id                 String                 @id @default(cuid())
  period             String
  status             String                 @default("DRAFT")
  currency           String                 @default("GHS")
  employeeCount      Int
  grossAmount        Decimal                @db.Decimal(16, 2)
  netBeforeStatutory Decimal                @db.Decimal(16, 2)
  lineItems          Json
  createdById        String
  createdAt          DateTime               @default(now())
  approvals          PayrollApprovalEvent[]

  @@index([period, createdAt])
}

// Append-only review decisions. PayrollCalculationBatch.status is the current workflow state.
model PayrollApprovalEvent {
  id         String                  @id @default(cuid())
  batchId    String
  batch      PayrollCalculationBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  actorId    String
  action     String
  fromStatus String
  toStatus   String
  reason     String?
  createdAt  DateTime                @default(now())

  @@index([batchId, createdAt])
}

// Effective-dated Ghana payroll settings. A new record is required when rules change.
model GhanaPayrollPolicy {
  id                  String    @id @default(cuid())
  effectiveFrom       DateTime  @unique @db.Date
  taxBands            Json
  ssnitEmployeeRate   Decimal   @db.Decimal(7, 5)
  employerPensionRate Decimal   @db.Decimal(7, 5)
  tier1Rate           Decimal   @db.Decimal(7, 5)
  tier2Rate           Decimal   @db.Decimal(7, 5)
  minimumInsurable    Decimal   @db.Decimal(14, 2)
  maximumInsurable    Decimal   @db.Decimal(14, 2)
  workDaysPerMonth    Int       @default(22)
  overtimeRates       Json
  approvedForUse      Boolean   @default(false)
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
}

// Approved manual attendance / pension adjustments; do not infer absences from missing clock records.
model GhanaPayrollAdjustment {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  period        String
  overtimeDays  Int       @default(0)
  unpaidDays    Decimal   @default(0) @db.Decimal(8, 2)
  tier3Employee Decimal   @default(0) @db.Decimal(14, 2)
  notes         String?
  status        String    @default("DRAFT")
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, period])
  @@index([period, status])
}

// Phase 15H: manual payroll payment register; does not transfer money.
model PayrollPayment {
  id                 String                @id @default(cuid())
  batchId            String
  employeeId         String
  period             String
  employeeName       String
  employeeNo         String?
  branch             String?
  netAmount          Decimal               @db.Decimal(16, 2)
  currency           String                @default("GHS")
  method             String                @default("BANK")
  recipientName      String?
  paymentDestination String?
  status             String                @default("PENDING")
  preparedById       String
  preparedAt         DateTime              @default(now())
  verifiedById       String?
  verifiedAt         DateTime?
  confirmedById      String?
  confirmedAt        DateTime?
  reference          String?
  notes              String?
  updatedAt          DateTime              @updatedAt
  events             PayrollPaymentEvent[]

  @@unique([batchId, employeeId])
  @@index([period, status])
}

model PayrollPaymentEvent {
  id         String         @id @default(cuid())
  paymentId  String
  payment    PayrollPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actorId    String
  action     String
  fromStatus String?
  toStatus   String
  detail     Json?
  createdAt  DateTime       @default(now())

  @@index([paymentId, createdAt])
}

// Phase 3: Training evaluation and participant feedback.
model TrainingEvaluationQuestion {
  id         String                     @id @default(cuid())
  trainingId String
  prompt     String
  kind       String                     @default("RATING") // RATING or TEXT
  category   String                     @default("GENERAL")
  required   Boolean                    @default(true)
  sortOrder  Int                        @default(0)
  createdAt  DateTime                   @default(now())
  training   Training                   @relation(fields: [trainingId], references: [id], onDelete: Restrict)
  answers    TrainingEvaluationAnswer[]

  @@index([trainingId, sortOrder])
}

model TrainingEvaluationResponse {
  id           String                     @id @default(cuid())
  trainingId   String
  enrollmentId String
  employeeId   String
  submittedAt  DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  training     Training                   @relation(fields: [trainingId], references: [id], onDelete: Restrict)
  enrollment   TrainingEnrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  employee     Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  answers      TrainingEvaluationAnswer[]

  @@unique([trainingId, enrollmentId])
  @@index([trainingId, submittedAt])
  @@index([employeeId])
}

model TrainingEvaluationAnswer {
  id         String                     @id @default(cuid())
  responseId String
  questionId String
  rating     Int?
  comment    String?
  response   TrainingEvaluationResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   TrainingEvaluationQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([responseId, questionId])
  @@index([questionId])
}

// Phase 3: Employee exit and offboarding. Existing onboarding tables are unchanged.
model EmployeeExitCase {
  id              String             @id @default(cuid())
  employeeId      String
  employee        Employee           @relation(fields: [employeeId], references: [id])
  reason          String
  reasonDetail    String?
  noticeDate      DateTime?
  lastWorkingDate DateTime
  status          String             @default("IN_PROGRESS")
  interviewNotes  String?
  settlementNotes String?
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tasks           EmployeeExitTask[]

  @@index([employeeId, status])
}

model EmployeeExitTask {
  id            String           @id @default(cuid())
  exitCaseId    String
  exitCase      EmployeeExitCase @relation(fields: [exitCaseId], references: [id], onDelete: Cascade)
  category      String
  title         String
  completed     Boolean          @default(false)
  completedById String?
  completedAt   DateTime?
  note          String?
  createdAt     DateTime         @default(now())

  @@index([exitCaseId])
}

// Phase 2: append-only hearing and appeal records linked to existing cases.
model DisciplinaryHearing {
  id String @id @default(cuid())
  caseId String
  case DisciplinaryCase @relation(fields: [caseId], references: [id])
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id])
  scheduledAt DateTime
  venue String
  panelMembers String
  representation String?
  allegations String
  employeeStatement String?
  findings String?
  outcome String?
  status String @default("SCHEDULED")
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([caseId, createdAt])
}

model DisciplinaryAppeal {
  id String @id @default(cuid())
  caseId String
  case DisciplinaryCase @relation(fields: [caseId], references: [id])
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id])
  grounds String
  status String @default("PENDING")
  reviewer String?
  outcome String?
  createdById String
  createdAt DateTime @default(now())
  decidedAt DateTime?
  @@index([caseId, createdAt])
}

// Phase 4: additive disciplinary workflow records; no changes to existing case data.
model DisciplinaryApprovalRequest {
  id String @id @default(cuid())
  caseId String
  requestedById String
  reviewedById String?
  actionType String
  proposal String
  reason String
  status String @default("PENDING")
  reviewNote String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  @@index([caseId, status])
}

model DisciplinaryLetter {
  id String @id @default(cuid())
  caseId String
  letterType String
  subject String
  body String @db.Text
  status String @default("DRAFT")
  createdById String
  issuedById String?
  createdAt DateTime @default(now())
  issuedAt DateTime?
  @@index([caseId, createdAt])
}

model DisciplinaryNotice {
  id String @id @default(cuid())
  caseId String
  recipientUserId String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([recipientUserId, readAt])
}

// Recruitment Phase 1 — additive staffing request and approval records.
model RecruitmentRequisition {
  id              String   @id @default(cuid())
  title           String
  department      String
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  positions       Int
  employmentType  String   @default("FULL_TIME")
  justification   String
  requestedById   String
  requestedByName String
  status          String   @default("PENDING_HR")
  hrReviewedById  String?
  hrReviewedAt    DateTime?
  hrNote          String?
  decidedById     String?
  decidedAt       DateTime?
  managementNote  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([branchId, status])
  @@index([createdAt])
}
